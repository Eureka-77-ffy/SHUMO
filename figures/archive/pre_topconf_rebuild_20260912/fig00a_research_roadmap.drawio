        <mxCell id="q3_body" value="&lt;b&gt;继承&lt;/b&gt; Q2 未舍入状态&lt;br&gt;&lt;b&gt;判据&lt;/b&gt; g(t)=max C−0.15&lt;br&gt;&lt;b&gt;搜索&lt;/b&gt; 稠密输出定位首穿&lt;br&gt;&lt;font color=&quot;#A36A20&quot;&gt;&lt;b&gt;终点&lt;/b&gt; 57.4740 h&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4DB;strokeColor=#D98B28;strokeWidth=1.7;fontSize=20;fontStyle=0;fontColor=#252936;fontFamily=Microsoft YaHei,PingFang SC,Songti SC,SimSun,Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;shadow=1;" vertex="1" parent="1">
