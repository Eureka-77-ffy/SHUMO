        <mxCell id="q2_body" value="&lt;b&gt;新增&lt;/b&gt; 状态相关物性&lt;br&gt;&lt;b&gt;求解&lt;/b&gt; T—C 双向耦合&lt;br&gt;&lt;b&gt;时域&lt;/b&gt; 0—3 h&lt;br&gt;&lt;font color=&quot;#3F4A9A&quot;&gt;&lt;b&gt;输出&lt;/b&gt; 耦合场与机制分解&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FA;strokeColor=#3F4A9A;strokeWidth=1.7;fontSize=20;fontStyle=0;fontColor=#252936;fontFamily=Microsoft YaHei,PingFang SC,Songti SC,SimSun,Helvetica;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;shadow=1;" vertex="1" parent="1">
